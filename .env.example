# Alpaca PAPER keys only. Never commit the real values.
# Copy to .env and fill in a dedicated paper account (not a live account).

ALPACA_OPTIONS_PAPER_KEY=PASTE_PAPER_KEY
ALPACA_OPTIONS_PAPER_SECRET=PASTE_PAPER_SECRET
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_BROKER_TAG=alpaca_options
OPTIONS_ONLY=1

# Submit lock. Leave 0 until you intend to place paper orders.
OPTIONS_PAPER_ARMED=0

# Optional: fail if the Alpaca CLI is missing (hackathon MCP/CLI identity check).
# ALPACA_CLI_REQUIRED=0

# Optional local data dir (default ~/.options-tournament)
# OPTIONS_TOURNAMENT_HOME=

# Featherless specialist roster (required for `propose`)
# FEATHERLESS_API_KEY=
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen3-4B-Instruct-2507
# DISCOVERY_HYPOTHESIS_MODEL=nvidia/OpenMath-Nemotron-32B
# DISCOVERY_STRATEGIST_MODEL=deepseek-ai/DeepSeek-V3-0324
# DISCOVERY_PROPOSER_MODEL=Qwen/Qwen3-32B
# DISCOVERY_CRITIC_MODEL=deepseek-ai/DeepSeek-V3-0324

# Optional OpenAI-compatible chat loop (used when Featherless is unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
